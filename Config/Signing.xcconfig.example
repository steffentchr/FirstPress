// Copy to Config/Signing.xcconfig (git-ignored) and fill in your own values.

// A bundle ID you own. Later tickets need the ShazamKit App Service enabled on it.
FIRSTPRESS_BUNDLE_ID = com.example.firstpress

// Your Apple developer team ID (Xcode › Settings › Accounts, or developer.apple.com › Membership).
FIRSTPRESS_DEVELOPMENT_TEAM = ABCDE12345
